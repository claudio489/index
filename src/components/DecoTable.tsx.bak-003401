import type { DiveTimelinePoint, DecoStop } from '@/lib/buhlmann'

interface Props {
  timeline: DiveTimelinePoint[]
  stops: DecoStop[]
  totalDecoTime?: number
  runTime?: number
  maxDepth?: number
  totalTime?: number
}

function ead(depth: number, gasName?: string): number {
  if (!gasName) return depth
  const fO2 = gasName.includes('50') ? 0.5 : gasName.includes('32') ? 0.32 : gasName.includes('36') ? 0.36 : gasName.includes('28') ? 0.28 : 0.21
  const fN2 = 1 - fO2
  if (fN2 <= 0) return 0
  return Math.round(((fN2 / 0.79) * (depth + 10)) - 10)
}

function fmtPara(m: number): string {
  if (m <= 0) return ''
  const min = Math.floor(m), sec = Math.round((m - min) * 60)
  return sec > 0 ? `${min}:${sec.toString().padStart(2, '0')}` : `${min}:00`
}

export function DecoTable({ timeline, maxDepth, totalTime, runTime, totalDecoTime }: Props) {
  if (!timeline || timeline.length === 0) return null
  const dispMax = maxDepth ?? 0, dispTot = totalTime ?? runTime ?? totalDecoTime ?? 0

  const filtered = timeline.filter(ev => ev.event !== 'Start' && !(ev.event.startsWith('Stop ') && ev.event.endsWith(' start')) && !ev.event.startsWith('Ascent to '))

  const rows = filtered.map((ev, idx) => {
    const isD = ev.event === 'Descent', isB = ev.event === 'Bottom', isG = ev.event.startsWith('Gas to'), isS = /^\d+m x \d+min$/.test(ev.event), isSu = ev.event === 'Surface'
    let icon = isD ? '\u{1F817}' : isB ? '\u{2194}' : isG || (isD && ev.depth > 0) ? '\u{1F815}' : isS ? '\u{1F6D1}' : isSu ? '\u{1F3E0}' : ''
    if (isD && idx === 0) icon = '\u{1F817}'

    let para = ''
    if (isB) {
      let nt = ev.time
      for (let j = idx + 1; j < filtered.length; j++) { if (filtered[j].event !== 'Descent') { nt = filtered[j].time; break } }
      const mins = nt - ev.time; if (mins > 0) para = fmtPara(mins)
    } else if (isS) { const m = ev.event.match(/^(\d+)m x (\d+)min$/); if (m) para = fmtPara(Number(m[2])) }

    let pO2 = '-'
    if (ev.pO2 !== undefined) pO2 = ev.pO2.toFixed(2)

    let eadVal = '-'
    if (!isSu && ev.depth >= 0) { const v = ead(ev.depth, ev.gasName || ev.gas); eadVal = String(v) }

    return { icon, prof: isSu ? '-' : Math.round(ev.depth), para, total: Math.round(ev.time), gas: ev.gasName || ev.gas || '', pO2, ead: eadVal }
  })

  return (
    <div className="mt-6 overflow-x-auto">
      <h3 className="text-lg font-semibold mb-3">Plan de Buceo</h3>
      <table className="w-full text-sm">
        <thead><tr className="border-b border-gray-600 text-gray-400 text-xs uppercase"><th className="text-left py-2 px-1 w-8"></th><th className="text-right py-2 px-2">Prof</th><th className="text-right py-2 px-2">Para</th><th className="text-right py-2 px-2">Total</th><th className="text-left py-2 px-2">Gas</th><th className="text-right py-2 px-2">pO2</th><th className="text-right py-2 px-2">EAD</th></tr></thead>
        <tbody>{rows.map((r, i) => (<tr key={i} className="border-b border-gray-800 hover:bg-gray-800/30"><td className="py-1.5 px-1 text-center text-lg">{r.icon}</td><td className="py-1.5 px-2 text-right font-mono">{r.prof}</td><td className="py-1.5 px-2 text-right font-mono text-gray-300">{r.para || '-'}</td><td className="py-1.5 px-2 text-right font-mono">{r.total}</td><td className="py-1.5 px-2 font-mono">{r.gas}</td><td className="py-1.5 px-2 text-right font-mono text-gray-400">{r.pO2}</td><td className="py-1.5 px-2 text-right font-mono text-gray-400">{r.ead}</td></tr>))}</tbody>
      </table>
      <div className="mt-4 grid grid-cols-3 gap-4 text-sm">
        <div className="bg-gray-800/50 rounded p-3"><div className="text-gray-400">Tiempo Total</div><div className="text-xl font-bold">{Math.round(dispTot)} min</div></div>
        <div className="bg-gray-800/50 rounded p-3"><div className="text-gray-400">Profundidad Max</div><div className="text-xl font-bold">{dispMax} m</div></div>
        <div className="bg-gray-800/50 rounded p-3"><div className="text-gray-400">Paradas Deco</div><div className="text-xl font-bold">{timeline.filter(e => /^\d+m x \d+min$/.test(e.event)).length}</div></div>
      </div>
    </div>
  )
}