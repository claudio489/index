// buhlmann.ts v4.2 - ZHL-16B (coincide con MultiDeco)
export interface Gas { fO2: number; fHe: number; name: string; mod?: number }
export interface DecoStop { depth: number; time: number; gas: Gas; gasName?: string }
export interface DiveTimelinePoint { time: number; depth: number; event: string; gas: string; gasName?: string; pO2?: number }
export interface DivePlan { runTime: number; totalDecoTime: number; stops: DecoStop[]; timeline: DiveTimelinePoint[]; ceilings: number[]; maxCeiling: number; tissues: number[]; cnsTotal: number; otuTotal: number }
export interface DiveInput { depth: number; bottomTime: number; bottomGas: Gas; decoGases: Gas[]; gfLow: number; gfHigh: number; descentRate: number; ascentRate: number }

const TISSUES: [number, number, number][] = [
  [4.0, 1.2599, 0.5050],[8.0, 1.0000, 0.6514],[12.5, 0.8618, 0.7222],
  [18.5, 0.7562, 0.7825],[27.0, 0.6667, 0.8126],[38.3, 0.5600, 0.8434],
  [54.3, 0.4940, 0.8693],[77.0, 0.4500, 0.8910],[109.0, 0.4187, 0.9092],
  [146.0, 0.3798, 0.9222],[187.0, 0.3497, 0.9319],[239.0, 0.3223, 0.9403],
  [305.0, 0.2971, 0.9477],[390.0, 0.2737, 0.9544],[498.0, 0.2523, 0.9602],[635.0, 0.2327, 0.9653]
]

const WV = 0.627, SP = 1.013
function absP(d: number) { return SP + d / 10 }
function ppN2(d: number, g: Gas) { return (absP(d) - WV) * (1 - g.fO2 - g.fHe) }
function ppO2(d: number, g: Gas) { return absP(d) * g.fO2 }

function haldane(p0: number, pAmb: number, ht: number, t: number): number {
  if (t <= 0) return p0
  const k = Math.LN2 / ht
  return pAmb + (p0 - pAmb) * Math.exp(-k * t)
}

function schreiner(p0: number, pS: number, pE: number, ht: number, t: number): number {
  if (t <= 0) return p0
  const k = Math.LN2 / ht, R = (pE - pS) / t, et = Math.exp(-k * t)
  return pS + R * (t - 1 / k) + (p0 - pS + R / k) * et
}

function ceilingP(tissues: number[], gf: number): number {
  let mx = 0
  for (let i = 0; i < 16; i++) {
    const [, a, b] = TISSUES[i]
    const ptol = (tissues[i] - a * gf) / (gf / b + 1 - gf)
    if (ptol > mx) mx = ptol
  }
  return mx
}

function p2d(p: number) { return Math.max(0, (p - SP) * 10) }

function curGF(depth: number, fsd: number, gl: number, gh: number): number {
  if (fsd <= 0 || depth <= 0) return gh
  if (depth >= fsd) return gl
  return gl + (gh - gl) * (1 - depth / fsd)
}

function cns(d: number, fO2: number, t: number): number {
  const p = ppO2(d, { fO2, fHe: 0, name: '' })
  if (p <= 0.5) return 0
  const lim = p > 1.6 ? 1 : p > 1.5 ? 5 : p > 1.4 ? 12 : p > 1.3 ? 24 : p > 1.2 ? 45 : p > 1.1 ? 75 : p > 1.0 ? 120 : p > 0.9 ? 180 : 240
  return (t / lim) * 100
}

function otu(d: number, fO2: number, t: number): number {
  const p = ppO2(d, { fO2, fHe: 0, name: '' })
  if (p <= 0.5) return 0
  return Math.pow(0.5 / (p - 0.5), -0.83) * t
}

export function calculateDivePlan(i: DiveInput): DivePlan {
  const { depth: maxD, bottomTime: bt, bottomGas: bg, decoGases: dg, gfLow, gfHigh, descentRate: dr, ascentRate: ar } = i
  const gfl = gfLow / 100, gfh = gfHigh / 100
  const tl: DiveTimelinePoint[] = []
  let t = 0, cnsTot = 0, otuTot = 0
  const ts: number[] = TISSUES.map(() => ppN2(0, bg))

  const dt = maxD / dr
  const pDs = ppN2(0, bg), pDe = ppN2(maxD, bg)
  for (let i = 0; i < 16; i++) { const [ht] = TISSUES[i]; ts[i] = schreiner(ts[i], pDs, pDe, ht, dt) }

  tl.push({ time: 0, depth: 0, event: 'Start', gas: bg.name, gasName: bg.name, pO2: Math.round(ppO2(0, bg) * 100) / 100 })

  for (let d = 10; d < maxD; d += 10) {
    const tt = d / dr
    tl.push({ time: Math.round(tt * 10) / 10, depth: d, event: 'Descent', gas: bg.name, gasName: bg.name, pO2: Math.round(ppO2(d, bg) * 100) / 100 })
  }

  t += dt
  cnsTot += cns(maxD / 2, bg.fO2, dt)
  otuTot += otu(maxD / 2, bg.fO2, dt)

  tl.push({ time: Math.round(t * 10) / 10, depth: maxD, event: 'Descent', gas: bg.name, gasName: bg.name, pO2: Math.round(ppO2(maxD, bg) * 100) / 100 })

  const pB = ppN2(maxD, bg)
  for (let i = 0; i < 16; i++) { const [ht] = TISSUES[i]; ts[i] = haldane(ts[i], pB, ht, bt) }
  t += bt
  cnsTot += cns(maxD, bg.fO2, bt)
  otuTot += otu(maxD, bg.fO2, bt)

  tl.push({ time: Math.round(t * 10) / 10, depth: maxD, event: 'Bottom', gas: bg.name, gasName: bg.name, pO2: Math.round(ppO2(maxD, bg) * 100) / 100 })

  const stops: DecoStop[] = []
  const ceilings: number[] = []
  const cl = ceilingP(ts, gfl)
  let fsd = Math.ceil(p2d(cl) / 3) * 3
  if (fsd < 3) fsd = 3
  if (fsd > maxD) fsd = maxD  // FIX: no puede ser mayor que profundidad actual

  let dG = bg
  const sorted = [...dg].sort((a, b) => b.fO2 - a.fO2)
  if (sorted.length > 0) dG = sorted[0]
  const dMOD = dG.mod ?? Math.floor((1.4 / dG.fO2 - 1) * 10)

  let cD = maxD, sD = fsd, gS = false, it = 0

  while (sD >= 3 && cD > 0 && it < 200) {
    it++

    // Ascenso al stop actual
    if (cD > sD) {
      const at = (cD - sD) / ar
      const pAs = ppN2(cD, gS ? dG : bg), pAe = ppN2(sD, gS ? dG : bg)
      for (let i = 0; i < 16; i++) { const [ht] = TISSUES[i]; ts[i] = schreiner(ts[i], pAs, pAe, ht, at) }
      t += at; cD = sD
    }

    // Gas switch ANTES de calcular la parada (si aplica)
    if (!gS && dG.name !== bg.name && sD <= dMOD) {
      gS = true
      tl.push({ time: Math.round(t * 10) / 10, depth: sD, event: `Gas to ${dG.name}`, gas: dG.name, gasName: dG.name, pO2: Math.round(ppO2(sD, dG) * 100) / 100 })
    }

    const g = curGF(sD, fsd, gfl, gfh)
    const pS = ppN2(sD, gS ? dG : bg)
    const nD = Math.max(0, sD - 3)

    // FIX: Simular minuto a minuto con los TEJIDOS REALES (no copia)
    let sT = 0
    while (sT < 300) {
      sT++
      for (let i = 0; i < 16; i++) { const [ht] = TISSUES[i]; ts[i] = haldane(ts[i], pS, ht, 1) }
      const cp = ceilingP(ts, g)
      if (p2d(cp) <= nD) break
    }

    // FIX: Siempre agregar la parada si hay tiempo > 0, incluso si llego al limite
    if (sT > 0) {
      const gU = gS ? dG : bg
      stops.push({ depth: sD, time: sT, gas: { ...gU }, gasName: gU.name })
      tl.push({ time: Math.round(t * 10) / 10, depth: sD, event: `${sD}m x ${sT}min`, gas: gU.name, gasName: gU.name, pO2: Math.round(ppO2(sD, gU) * 100) / 100 })
      t += sT
      cnsTot += cns(sD, gU.fO2, sT)
      otuTot += otu(sD, gU.fO2, sT)
    }

    ceilings.push(Math.round(p2d(ceilingP(ts, g))))
    sD = nD
  }

  if (cD > 0) t += cD / ar
  const fG = gS ? dG : bg
  tl.push({ time: Math.round(t * 10) / 10, depth: 0, event: 'Surface', gas: fG.name, gasName: fG.name, pO2: Math.round(ppO2(0, fG) * 100) / 100 })

  const tdt = stops.reduce((a, s) => a + s.time, 0)
  return { runTime: Math.round(t), totalDecoTime: tdt, stops, timeline: tl, ceilings, maxCeiling: fsd, tissues: [...ts], cnsTotal: Math.round(cnsTot), otuTotal: Math.round(otuTot) }
}

export function calculateNo50Plan(input: DiveInput) { return calculateDivePlan({ ...input, decoGases: [] }) }
export function calculateNDL(d: number, g: Gas, gl: number = 30, gh: number = 70): number {
  let lo = 0, hi = 180
  while (hi - lo > 1) { const m = (lo + hi) >> 1; const p = calculateDivePlan({ depth: d, bottomTime: m, bottomGas: g, decoGases: [], gfLow: gl, gfHigh: gh, descentRate: 18, ascentRate: 9 }); p.stops.length === 0 ? (lo = m) : (hi = m) }
  return lo
}
export { TISSUES as ZHL16B_TISSUES }
export type TimelineEntry = DiveTimelinePoint
